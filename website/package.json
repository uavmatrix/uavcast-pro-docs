{
  "name": "uavmatrix-docs",
  "version": "2.0.0",
  "private": true,
  "description": "UAVmatrix documentation site: UAVcast-Pro and Fleet Manager (docs.uavmatrix.com)",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 0.0.0.0",
    "build": "docusaurus build --locale en",
    "build:all": "docusaurus build",
    "serve": "node scripts/serve.mjs build --port 4100 --host 0.0.0.0",
    "serve:docusaurus": "docusaurus serve --host 0.0.0.0 --port 4100 --no-open",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "check:redirects": "node scripts/check-redirects.mjs",
    "og-image": "node scripts/render-og-image.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "image-size": "^2.0.2",
    "minisearch": "^7.2.0",
    "node-html-parser": "^9.0.7",
    "posthog-js": "^1.455.4",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
