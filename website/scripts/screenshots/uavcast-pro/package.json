{
  "name": "uavcast-pro-screenshots",
  "private": true,
  "type": "module",
  "description": "Manifest-driven, read-only Playwright capture of UAVcast-Pro UI screenshots for docs.",
  "scripts": {
    "capture": "tsx capture.ts",
    "capture:en": "tsx capture.ts --locale en",
    "list": "tsx capture.ts --list",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "@types/node": "22.10.2",
    "playwright": "1.49.1",
    "sharp": "0.33.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
